# ProposalCraft AI - Environment Configuration

# --- App ---
APP_NAME=ProposalCraft AI
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=proposalcraft
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# --- JWT ---
JWT_SECRET_KEY=your-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth ---
PASSWORD_BCRYPT_ROUNDS=12

# --- LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence_transformers

# --- Caching ---
ENABLE_LLM_CACHE=true
ENABLE_EMBEDDING_CACHE=true
ENABLE_RAG_CACHE=true
REDIS_URL=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Email ---
SENDGRID_API_KEY=
FROM_EMAIL=noreply@proposalcraft.ai

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_ORG=1000
RATE_LIMIT_WINDOW_SECONDS=60

# --- Upload ---
MAX_UPLOAD_SIZE_MB=10
STORAGE_BACKEND=local
